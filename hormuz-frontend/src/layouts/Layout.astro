  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://hormuztracker.tech/og-image.png" />

  <!-- JSON-LD: Organization + WebApplication -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "HormuzTracker.tech",
    "url": "https://hormuztracker.tech",
    "description": "Real-time Strait of Hormuz monitoring dashboard. Track shipping disruptions, oil prices, vessel seizures, insurance status, and global trade impact.",
    "applicationCategory": "MonitoringApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "author": {
      "@type": "Organization",
      "name": "HormuzTracker.tech",
      "url": "https://hormuztracker.tech",
      "logo": "https://hormuztracker.tech/favicon.svg"
    },
    "sameAs": [],
    "potentialAction": {
      "@type": "ViewAction",
      "target": "https://hormuztracker.tech",
      "name": "View Live Crisis Dashboard"
    }
  })} />

  <!-- JSON-LD: BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://hormuztracker.tech" },
      { "@type": "ListItem", "position": 2, "name": title.split('—')[0].trim(), "item": `https://hormuztracker.tech${path}` }
    ]
  })} />

  <!-- Page-specific JSON-LD -->
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <title>{title}</title>
</head>
<body class="min-h-screen bg-ops-950 text-slate-200">
