---
import '../styles/global.css';
import ShareButton from '../components/ShareButton.svelte';

export interface Props {
  title?: string;
  description?: string;
  path?: string;
  jsonLd?: object;
}

const { title = 'HormuzTracker.tech — Live Strait of Hormuz Crisis Monitor', description = 'Real-time Strait of Hormuz monitoring dashboard. Track shipping disruptions, oil prices, vessel seizures, insurance status, and global trade impact.', path = '/', jsonLd } = Astro.props;
const crisisStart = new Date('2026-02-28T00:00:00Z');
const dayNumber = Math.floor((Date.now() - crisisStart.getTime()) / 86400000);
const currentPath = path;

// Active nav helper
function isActive(href: string): string {
  if (href === '/' && currentPath === '/') return 'text-white bg-ops-800';
  if (href !== '/' && currentPath.startsWith(href)) return 'text-white bg-ops-800';
  return '';
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="Strait of Hormuz, Hormuz crisis, oil prices, shipping disruption, tanker tracking, war risk insurance, Brent crude, vessel monitoring, Hormuz tracker, Strait closure" />
  <meta name="author" content="HormuzTracker.tech" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <!-- Google AdSense placeholder - replace with your publisher ID -->
  <!-- <meta name="google-adsense-account" content="ca-pub-XXXXXXXXXXXXXXXX" /> -->
  <meta name="theme-color" content="#0a1628" />

  <link rel="canonical" href={`https://hormuztracker.tech${path}`} />
  <meta name="date" content={new Date().toISOString().split('T')[0]} />
