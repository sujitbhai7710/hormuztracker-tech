---
import Layout from '../../layouts/Layout.astro';
import { allPosts } from '../../data/blog-index';

const catColors = { 
  Analysis: 'bg-crisis-red/20 text-crisis-red', 
  Diplomacy: 'bg-crisis-blue/20 text-crisis-blue', 
  Explainer: 'bg-crisis-amber/20 text-crisis-amber', 
  Military: 'bg-red-700/20 text-red-400', 
  Economic: 'bg-crisis-amber/20 text-crisis-amber',
  Investigation: 'bg-purple-700/20 text-purple-400'
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "HormuzTracker Analysis Blog",
  "description": "In-depth analysis and expert commentary on the Strait of Hormuz crisis, shipping disruptions, oil price impacts, and global trade consequences.",
  "url": "https://hormuztracker.tech/blog",
  "isPartOf": {
    "@type": "WebSite",
    "name": "HormuzTracker.tech",
    "url": "https://hormuztracker.tech"
  },
  "publisher": {
    "@type": "NewsMediaOrganization",
    "name": "HormuzTracker.tech",
    "url": "https://hormuztracker.tech",
    "logo": {
      "@type": "ImageObject",
      "url": "https://hormuztracker.tech/og-image.png"
    }
  },
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": allPosts.length,
    "itemListElement": allPosts.slice(0, 10).map((post, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://hormuztracker.tech/blog/${post.slug}`,
      "name": post.title
    }))
  }
};
---

<Layout 
  title="Analysis Blog — HormuzTracker.tech" 
  description="Expert analysis of the Strait of Hormuz crisis. Coverage of shipping disruptions, oil prices, military operations, diplomacy, and global economic impact from our team of maritime and energy correspondents."
  path="/blog"
  jsonLd={jsonLd}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-8">
    <!-- Header -->
    <div>
      <nav class="text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
        <a href="/" class="hover:text-slate-300">Home</a>
        <span class="mx-1">/</span>
        <span class="text-slate-400">Analysis Blog</span>
      </nav>
      <h1 class="text-3xl font-bold text-white">Analysis and commentary</h1>
      <p class="text-slate-400 mt-2 max-w-2xl">Reporting from our team of maritime correspondents, energy analysts, and diplomatic editors covering the Strait of Hormuz crisis as it unfolds.</p>
    </div>

    <!-- Featured: latest post -->
    {allPosts.length > 0 && (
      <a href={`/blog/${allPosts[0].slug}`} class="block glass-card p-6 card-hover border-l-4 border-crisis-red">
        <div class="flex items-center gap-2 mb-2">
          <span class={`px-2 py-0.5 rounded text-xs font-bold ${catColors[allPosts[0].category] || 'bg-slate-700 text-slate-300'}`}>{allPosts[0].category}</span>
          <span class="text-xs text-slate-500">{allPosts[0].readingTime} read</span>
          <span class="text-xs text-slate-600">|</span>
          <span class="text-xs text-slate-500">By {allPosts[0].authorName}</span>
        </div>
        <h2 class="text-xl font-bold text-white leading-snug mb-2">{allPosts[0].title}</h2>
        <p class="text-sm text-slate-400 line-clamp-2">{allPosts[0].excerpt}</p>
        <div class="text-xs text-slate-500 mt-3">{new Date(allPosts[0].date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</div>
      </a>
    )}

    <!-- Category filter tabs -->
    <div class="flex flex-wrap gap-2">
      <span class="text-xs text-slate-500 self-center mr-2">Filter:</span>
      {['All', 'Analysis', 'Diplomacy', 'Military', 'Economic', 'Explainer', 'Investigation'].map(cat => (
        <button 
          data-category={cat === 'All' ? '' : cat.toLowerCase()} 
          class="blog-filter-btn px-3 py-1 rounded-full text-xs font-medium bg-slate-800 text-slate-400 hover:text-white hover:bg-slate-700 transition-colors"
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Post grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="blog-grid">
      {allPosts.map((post, i) => (
        <a 
          href={`/blog/${post.slug}`} 
          class="glass-card p-5 card-hover block blog-post-card"
          data-category={post.category.toLowerCase()}
        >
          <div class="flex items-center gap-2 mb-2">
            <span class={`px-2 py-0.5 rounded text-xs font-bold ${catColors[post.category] || 'bg-slate-700 text-slate-300'}`}>{post.category}</span>
            <span class="text-xs text-slate-500">{post.readingTime}</span>
          </div>
          <h2 class="text-base font-bold text-white leading-snug mb-2">{post.title}</h2>
          <p class="text-xs text-slate-400 line-clamp-2">{post.excerpt}</p>
          <div class="flex items-center justify-between mt-3">
            <span class="text-xs text-slate-500">{new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            <span class="text-xs text-slate-600">By {post.authorName}</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Editorial standards notice for E-E-A-T / AdSense -->
    <div class="glass-card p-6 mt-8">
      <h2 class="text-lg font-bold text-white mb-3">Our editorial standards</h2>
      <p class="text-sm text-slate-400 leading-relaxed">HormuzTracker.tech follows rigorous editorial standards. Every article is fact-checked before publication. Our correspondents have decades of combined experience in maritime reporting, energy markets, and geopolitical analysis. We correct errors promptly and transparently. Our methodology and data sources are documented on our <a href="/methodology" class="text-crisis-blue hover:underline">methodology page</a>. If you find an error, please <a href="/contact" class="text-crisis-blue hover:underline">contact our editorial team</a>.</p>
    </div>
  </div>

  <script>
    // Category filter
    const buttons = document.querySelectorAll('.blog-filter-btn');
    const cards = document.querySelectorAll('.blog-post-card');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('bg-crisis-blue/20', 'text-crisis-blue'));
        btn.classList.add('bg-crisis-blue/20', 'text-crisis-blue');
        
        const category = btn.dataset.category;
        cards.forEach(card => {
          if (!category || card.dataset.category === category) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
