---

<Layout title={`${title} — HormuzTracker.tech`} description={excerpt} path={`/blog/${slug}`}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 py-6 space-y-6">
    <div class="flex items-center gap-2 mb-2">
      <a href="/blog" class="text-xs text-crisis-blue hover:text-crisis-blue/80">← All Articles</a>
    </div>
    <div>
      <span class={`px-2 py-0.5 rounded text-xs font-bold ${catColors[category] || 'bg-slate-700 text-slate-300'}`}>{category}</span>
      <h1 class="text-3xl font-black text-white mt-3">{title}</h1>
      <div class="flex items-center gap-3 mt-3 text-xs text-slate-500">
        <span>{new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
        <span>·</span>
        <span>{readingTime} read</span>
      </div>
    </div>

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <div class="glass-card p-6">
      <p class="text-slate-300 leading-relaxed text-lg font-medium">{excerpt}</p>
      <div class="mt-6 prose prose-invert prose-sm max-w-none article-content">
        <Fragment set:html={content} />
      </div>
    </div>

    <!-- Share -->
    <div class="flex items-center gap-3">
      <span class="text-xs text-slate-500">Share:</span>
      <button onclick="navigator.clipboard.writeText(window.location.href)" class="px-3 py-1 rounded text-xs bg-ops-800 text-slate-300 hover:bg-ops-700 transition-colors">Copy Link</button>
      <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(title)}`} class="px-3 py-1 rounded text-xs bg-ops-800 text-slate-300 hover:bg-ops-700 transition-colors" target="_blank" rel="noopener">Twitter</a>
    </div>
  </article>
</Layout>

