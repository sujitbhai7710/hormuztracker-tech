const { slug, title, date, category, readingTime, excerpt, content } = Astro.props;
const catColors = { Analysis: 'bg-crisis-red/20 text-crisis-red', Diplomacy: 'bg-crisis-blue/20 text-crisis-blue', Explainer: 'bg-crisis-amber/20 text-crisis-amber', Military: 'bg-red-700/20 text-red-400', Economic: 'bg-crisis-amber/20 text-crisis-amber' };

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": title,
  "datePublished": date,
  "dateModified": date,
  "author": {
    "@type": "Organization",
    "name": "HormuzTracker.tech"
  },
  "publisher": {
