---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Crisis Timeline — HormuzTracker.tech" description="Chronological timeline of the Strait of Hormuz crisis events including military, diplomatic, and economic developments with color-coded categories." path="/timeline">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 space-y-6" id="timeline-page">
    <div>
      <h1 class="text-2xl font-bold text-white">Crisis Timeline</h1>
      <p class="text-sm text-slate-400 mt-1">Chronological events from the Hormuz crisis</p>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap gap-2" id="timeline-filters">
      <button data-filter="ALL" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-crisis-red/20 text-crisis-red border border-crisis-red/30 hover:bg-crisis-red/30 transition-colors active-filter">All</button>
      <button data-filter="ESCALATION" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 border border-ops-700/50 hover:bg-ops-800 transition-colors">
        <span class="inline-block w-2 h-2 rounded-full bg-crisis-red mr-1"></span>Escalation
      </button>
      <button data-filter="MILITARY" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 border border-ops-700/50 hover:bg-ops-800 transition-colors">
        <span class="inline-block w-2 h-2 rounded-full bg-red-700 mr-1"></span>Military
      </button>
      <button data-filter="DIPLOMATIC" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 border border-ops-700/50 hover:bg-ops-800 transition-colors">
        <span class="inline-block w-2 h-2 rounded-full bg-crisis-blue mr-1"></span>Diplomatic
      </button>
      <button data-filter="ECONOMIC" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 border border-ops-700/50 hover:bg-ops-800 transition-colors">
        <span class="inline-block w-2 h-2 rounded-full bg-crisis-amber mr-1"></span>Economic
      </button>
      <button data-filter="DE-ESCALATION" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 border border-ops-700/50 hover:bg-ops-800 transition-colors">
        <span class="inline-block w-2 h-2 rounded-full bg-crisis-green mr-1"></span>De-escalation
      </button>
    </div>

    <!-- Event Count -->
    <div class="text-xs text-slate-500" id="event-count">Loading events...</div>

    <!-- Timeline -->
    <div id="timeline-container" class="space-y-0"></div>
  </div>

  <script>
    // Static timeline data (no external API)
    const TIMELINE_DATA = [
      { date: 'Feb 28, 2026', type: 'ESCALATION', title: 'Strait of Hormuz Closed', description: 'Iran announces closure of the Strait of Hormuz to commercial shipping following escalation of tensions. All vessels ordered to divert.' },
      { date: 'Mar 1, 2026', type: 'ECONOMIC', title: 'Brent Crude Surges 20%', description: 'Oil prices spike as markets react to the Hormuz closure. Brent jumps from $74.50 to $89.20 in a single session.' },
      { date: 'Mar 1, 2026', type: 'MILITARY', title: 'US 5th Fleet Deployed', description: 'The US Navy deploys additional vessels to the Persian Gulf region as part of Operation Freedom of Navigation.' },
      { date: 'Mar 3, 2026', type: 'ESCALATION', title: 'Carriers Suspend Transit', description: 'All nine major container carriers announce suspension of Hormuz transit. Vessels rerouted via Cape of Good Hope.' },
      { date: 'Mar 10, 2026', type: 'ECONOMIC', title: 'P&I Clubs Withdraw Coverage', description: 'All six major Protection and Indemnity clubs cancel Hormuz transit insurance. War risk premiums surge to 3%+ of hull value.' },
      { date: 'Mar 20, 2026', type: 'MILITARY', title: 'First Vessel Seizure', description: 'Iran seizes Marshall Islands-flagged tanker MV Pacific Voyager in international waters near the strait.' },
      { date: 'Apr 1, 2026', type: 'DIPLOMATIC', title: 'Oman Mediation Begins', description: 'Oman initiates back-channel talks between Iran and Western powers aimed at establishing a safe transit corridor.' },
      { date: 'Apr 5, 2026', type: 'MILITARY', title: 'US Retaliatory Seizure', description: 'US Navy detains Iranian-flagged cargo vessel MV Shiraz in the Arabian Sea in a tit-for-tat response.' },
      { date: 'Apr 15, 2026', type: 'ECONOMIC', title: 'SPR Drawdown Announced', description: 'The US announces a Strategic Petroleum Reserve drawdown of 30 million barrels to stabilize domestic prices.' },
      { date: 'Apr 25, 2026', type: 'ESCALATION', title: 'LNG Carrier Seized', description: 'Iran seizes Bermuda-flagged LNG carrier MV Brave Explorer, marking a significant escalation in the seizure campaign.' },
      { date: 'May 24, 2026', type: 'DIPLOMATIC', title: 'Beijing Summit', description: 'China hosts an emergency summit bringing together Iran, Saudi Arabia, UAE, and Oman to discuss a safe transit corridor.' },
      { date: 'Jun 1, 2026', type: 'DE-ESCALATION', title: 'Humanitarian Corridor Proposed', description: 'UN proposes a humanitarian shipping corridor for essential goods, though military and energy shipments remain contested.' },
    ];
    let allEvents = TIMELINE_DATA;
    const typeColors = {
      ESCALATION: 'bg-crisis-red',
      MILITARY: 'bg-red-700',
      ECONOMIC: 'bg-crisis-amber',
      DIPLOMATIC: 'bg-crisis-blue',
      'DE-ESCALATION': 'bg-crisis-green'
    };
    const typeBgColors = {
      ESCALATION: 'border-crisis-red/20',
      MILITARY: 'border-red-700/20',
      ECONOMIC: 'border-crisis-amber/20',
      DIPLOMATIC: 'border-crisis-blue/20',
      'DE-ESCALATION': 'border-crisis-green/20'
    };

    function loadTimeline() {
        allEvents = TIMELINE_DATA;
        document.getElementById('event-count').textContent = `${allEvents.length} events loaded`;
        renderTimeline('ALL');
    }

    function renderTimeline(filter) {
      const filtered = filter === 'ALL' ? allEvents : allEvents.filter(e => e.type === filter);
      document.getElementById('event-count').textContent = `Showing ${filtered.length} of ${allEvents.length} events`;
      document.getElementById('timeline-container').innerHTML = filtered.map((e, i) => {
        const color = typeColors[e.type] || 'bg-slate-500';
        const borderColor = typeBgColors[e.type] || 'border-ops-700/30';
        return `
        <div class="flex gap-4 animate-fade-in" style="animation-delay: ${i * 50}ms">
          <div class="flex flex-col items-center">
            <div class="w-4 h-4 rounded-full ${color} border-2 border-ops-950 flex-shrink-0 z-10"></div>
            <div class="w-0.5 flex-1 bg-ops-700/50"></div>
          </div>
          <div class="pb-6 flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-mono text-slate-500">${e.date}</span>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-bold ${color} text-white">${e.type}</span>
            </div>
            <div class="glass-card p-4 card-hover border ${borderColor}">
              <h3 class="text-sm font-bold text-white mb-1">${e.title}</h3>
              <p class="text-xs text-slate-400">${e.description}</p>
            </div>
          </div>
        </div>`;
      }).join('');
    }

    // Filter buttons
    document.querySelectorAll('#timeline-filters button').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#timeline-filters button').forEach(b => {
          b.className = b.className.replace(/bg-crisis-red\/20 text-crisis-red border-crisis-red\/30/g, '').replace('active-filter', '') + ' text-slate-400 border-ops-700/50';
        });
        btn.className = btn.className.replace('text-slate-400 border-ops-700/50', '') + ' bg-crisis-red/20 text-crisis-red border-crisis-red/30 active-filter';
        renderTimeline(btn.dataset.filter);
      });
    });

    loadTimeline();
  </script>
</Layout>
