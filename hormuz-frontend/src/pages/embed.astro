---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Embed Widgets — HormuzTracker.tech" description="Embed live Hormuz crisis monitoring widgets on your website. Free embeddable iframes for severity, ships, oil prices, and full dashboard." path="/embed">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-white">Embed Widgets</h1>
      <p class="text-sm text-slate-400 mt-1">Add live Hormuz crisis data to your website</p>
    </div>

    <div class="space-y-6">
      <!-- Severity Badge -->
      <div class="glass-card p-5">
        <h2 class="text-lg font-bold text-white mb-3">Severity Badge</h2>
        <p class="text-sm text-slate-400 mb-3">Compact 220x80px badge showing crisis severity level and day count.</p>
        <div class="bg-ops-900/50 rounded-lg p-4 mb-3 flex items-center justify-center">
          <div class="bg-crisis-red/10 border border-crisis-red/30 rounded-lg px-4 py-2 text-center">
            <div class="text-xs text-crisis-red font-bold">SEVERITY 10/10</div>
            <div class="text-lg font-black text-white">DAY 88</div>
          </div>
        </div>
        <div class="bg-ops-950 rounded-lg p-3">
          <code class="text-xs text-slate-300 font-mono">&lt;iframe src="https://hormuztracker.tech/embed/severity" width="220" height="80" frameborder="0"&gt;&lt;/iframe&gt;</code>
        </div>
        <button onclick="navigator.clipboard.writeText('<iframe src=&quot;https://hormuztracker.tech/embed/severity&quot; width=&quot;220&quot; height=&quot;80&quot; frameborder=&quot;0&quot;></iframe>')" class="mt-2 px-3 py-1 rounded text-xs bg-ops-800 text-slate-300 hover:bg-ops-700 transition-colors">Copy Code</button>
      </div>

      <!-- Ship Count Widget -->
      <div class="glass-card p-5">
        <h2 class="text-lg font-bold text-white mb-3">Ship Count Widget</h2>
        <p class="text-sm text-slate-400 mb-3">300x200px widget showing current vessel counts and transit data.</p>
        <div class="bg-ops-950 rounded-lg p-3">
          <code class="text-xs text-slate-300 font-mono">&lt;iframe src="https://hormuztracker.tech/embed/ships" width="300" height="200" frameborder="0"&gt;&lt;/iframe&gt;</code>
        </div>
        <button onclick="navigator.clipboard.writeText('<iframe src=&quot;https://hormuztracker.tech/embed/ships&quot; width=&quot;300&quot; height=&quot;200&quot; frameborder=&quot;0&quot;></iframe>')" class="mt-2 px-3 py-1 rounded text-xs bg-ops-800 text-slate-300 hover:bg-ops-700 transition-colors">Copy Code</button>
      </div>

      <!-- Oil Prices Widget -->
      <div class="glass-card p-5">
        <h2 class="text-lg font-bold text-white mb-3">Oil Prices Widget</h2>
        <p class="text-sm text-slate-400 mb-3">300x400px widget showing live oil and energy commodity prices.</p>
        <div class="bg-ops-950 rounded-lg p-3">
          <code class="text-xs text-slate-300 font-mono">&lt;iframe src="https://hormuztracker.tech/embed/oil" width="300" height="400" frameborder="0"&gt;&lt;/iframe&gt;</code>
        </div>
        <button onclick="navigator.clipboard.writeText('<iframe src=&quot;https://hormuztracker.tech/embed/oil&quot; width=&quot;300&quot; height=&quot;400&quot; frameborder=&quot;0&quot;></iframe>')" class="mt-2 px-3 py-1 rounded text-xs bg-ops-800 text-slate-300 hover:bg-ops-700 transition-colors">Copy Code</button>
      </div>

      <!-- Full Dashboard Widget -->
      <div class="glass-card p-5">
        <h2 class="text-lg font-bold text-white mb-3">Full Dashboard Widget</h2>
        <p class="text-sm text-slate-400 mb-3">Complete 100%x800px dashboard embed with all monitoring data.</p>
        <div class="bg-ops-950 rounded-lg p-3">
          <code class="text-xs text-slate-300 font-mono">&lt;iframe src="https://hormuztracker.tech/embed/dashboard" width="100%" height="800" frameborder="0"&gt;&lt;/iframe&gt;</code>
        </div>
        <button onclick="navigator.clipboard.writeText('<iframe src=&quot;https://hormuztracker.tech/embed/dashboard&quot; width=&quot;100%&quot; height=&quot;800&quot; frameborder=&quot;0&quot;></iframe>')" class="mt-2 px-3 py-1 rounded text-xs bg-ops-800 text-slate-300 hover:bg-ops-700 transition-colors">Copy Code</button>
      </div>
    </div>
  </div>
</Layout>
