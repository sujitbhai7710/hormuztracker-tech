---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Regional Impact — HormuzTracker.tech" description="Country-by-country analysis of the Strait of Hormuz crisis impact on oil imports, LNG supply, and economic stability." path="/regions">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6" id="regions-page">
    <div>
      <h1 class="text-2xl font-bold text-white">Regional Impact & Trade Exposure</h1>
      <p class="text-sm text-slate-400 mt-1">How the Hormuz crisis affects nations dependent on Gulf energy imports</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="region-cards"></div>

    <!-- Global Impact Summary -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">Global Exposure Summary</h2>
      <div class="prose prose-invert prose-sm max-w-none">
        <p class="text-slate-300 leading-relaxed">The Strait of Hormuz closure has created a differentiated impact across the global economy, with the severity of exposure directly correlated to each nation's dependence on Gulf hydrocarbon imports. Japan and South Korea face the most acute crisis, with 88% and 73% of their respective crude oil imports transiting the strait. These nations have limited alternative supply sources and their strategic petroleum reserves, while substantial, provide only weeks of coverage at current consumption rates.</p>
        <p class="text-slate-300 leading-relaxed mt-3">China and India occupy a middle tier of exposure. China has been actively diversifying its energy supply through overland pipelines from Russia and Central Asia, but 40% of its crude still depends on the Gulf route. India has dramatically increased Russian oil imports, which now account for nearly 40% of its total crude intake, but the remaining Gulf dependency still represents a critical vulnerability. The European Union and United States face more moderate direct exposure, though the secondary effects through LNG disruption and global price transmission remain significant.</p>
      </div>
    </div>
  </div>

  <script>
    // Static region data (no external API)
    const REGIONS_DATA = [
      { name: 'Japan', slug: 'japan', severity: 'CRITICAL', oilDependencyPercent: 88, lngDependency: 35, description: '88% of crude oil imports transit Hormuz. Strategic reserves provide ~90 days of coverage. LNG imports from Qatar severely disrupted.' },
      { name: 'South Korea', slug: 'south-korea', severity: 'CRITICAL', oilDependencyPercent: 73, lngDependency: 42, description: '73% crude oil dependency on Hormuz route. Major refining sector impacted. Diversifying to US and Russian crude.' },
      { name: 'China', slug: 'china', severity: 'HIGH', oilDependencyPercent: 40, lngDependency: 18, description: '40% of crude imports via Hormuz. Overland pipelines from Russia provide partial alternative. SPR provides ~60 days coverage.' },
      { name: 'India', slug: 'india', severity: 'HIGH', oilDependencyPercent: 52, lngDependency: 25, description: '52% crude dependency on Gulf route. Increased Russian oil imports help offset. Strategic reserves limited to ~30 days.' },
      { name: 'European Union', slug: 'eu', severity: 'MODERATE', oilDependencyPercent: 25, lngDependency: 30, description: '25% crude via Hormuz, but 30% LNG dependency on Qatar. TTF gas prices surged 85%. Southern Europe most exposed.' },
      { name: 'United States', slug: 'us', severity: 'LOW', oilDependencyPercent: 8, description: 'Only 8% crude imports via Hormuz. Net energy exporter. Price impact through global market correlation. SPR drawdown capability.' },
      { name: 'Singapore', slug: 'singapore', severity: 'HIGH', oilDependencyPercent: 65, description: 'Major refining hub dependent on Gulf crude. 65% of feedstock transits Hormuz. Bunkering operations severely impacted.' },
      { name: 'Australia', slug: 'australia', severity: 'MODERATE', oilDependencyPercent: 30, lngDependency: 22, description: '30% crude via Hormuz. LNG exports partially offset by domestic supply. Fuel prices up 25%+ since crisis began.' },
    ];

    function loadRegions() {
        const regions = REGIONS_DATA;
        const sevColors = { CRITICAL: 'border-l-crisis-red', HIGH: 'border-l-crisis-orange', MODERATE: 'border-l-crisis-amber', LOW: 'border-l-crisis-green' };
        const sevText = { CRITICAL: 'text-crisis-red', HIGH: 'text-crisis-orange', MODERATE: 'text-crisis-amber', LOW: 'text-crisis-green' };

        document.getElementById('region-cards').innerHTML = regions.map(r => `
          <a href="/regions/${r.slug}" class="glass-card p-5 card-hover border-l-4 ${sevColors[r.severity] || 'border-l-slate-500'}">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-lg font-bold text-white">${r.name}</h3>
              <span class="text-xs font-bold ${sevText[r.severity] || 'text-slate-400'}">${r.severity}</span>
            </div>
            <div class="space-y-2">
              <div>
                <div class="text-xs text-slate-500">Oil Dependency</div>
                <div class="flex items-center gap-2">
                  <div class="flex-1 bg-ops-800 rounded-full h-2 overflow-hidden">
                    <div class="h-full bg-crisis-red rounded-full" style="width: ${r.oilDependencyPercent}%"></div>
                  </div>
                  <span class="text-xs font-bold text-white">${r.oilDependencyPercent}%</span>
                </div>
              </div>
              ${r.lngDependency ? `<div><div class="text-xs text-slate-500">LNG Dependency</div><div class="flex items-center gap-2"><div class="flex-1 bg-ops-800 rounded-full h-2 overflow-hidden"><div class="h-full bg-crisis-amber rounded-full" style="width: ${r.lngDependency}%"></div></div><span class="text-xs font-bold text-white">${r.lngDependency}%</span></div></div>` : ''}
              <p class="text-xs text-slate-400 line-clamp-2">${r.description}</p>
            </div>
          </a>
        `).join('');
    }
    loadRegions();
  </script>
</Layout>
