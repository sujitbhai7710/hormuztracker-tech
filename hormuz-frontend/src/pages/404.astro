---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found — HormuzTracker.tech" description="The page you requested could not be found. Return to the Hormuz crisis monitor dashboard." path="/404">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-20 text-center">
    <div class="glass-card p-10 animate-fade-in">
      <div class="text-8xl font-black gradient-text-red mb-4">404</div>
      <h1 class="text-2xl font-bold text-white mb-2">Page Not Found</h1>
      <p class="text-slate-400 mb-6">The page you're looking for doesn't exist or has been moved. The Strait of Hormuz may be disrupted, but your URL is definitely broken.</p>
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-crisis-red/20 text-crisis-red border border-crisis-red/30 font-semibold hover:bg-crisis-red/30 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        Return to Dashboard
      </a>
      <div class="mt-8 pt-6 border-t border-ops-700/50">
        <p class="text-xs text-slate-500">You will be automatically redirected to the dashboard in <span id="countdown" class="text-crisis-orange font-bold font-mono">10</span> seconds</p>
      </div>
    </div>
  </div>

  <script>
    let seconds = 10;
    const el = document.getElementById('countdown');
    const timer = setInterval(() => {
      seconds--;
      if (el) el.textContent = seconds;
      if (seconds <= 0) {
        clearInterval(timer);
        window.location.href = '/';
      }
    }, 1000);
  </script>
</Layout>
