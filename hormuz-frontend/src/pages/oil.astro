---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Oil & Energy Prices — HormuzTracker.tech" description="Live oil prices, energy market data, Brent crude, WTI, TTF gas, gasoline tracking with pre-crisis comparison and market analysis." path="/oil">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6" id="oil-page">
    <div>
      <h1 class="text-2xl font-bold text-white">Oil & Energy Markets</h1>
      <p class="text-sm text-slate-400 mt-1">Live commodity prices and market analysis amid the Hormuz crisis</p>
    </div>

    <!-- Price Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4" id="price-cards">
      <div class="glass-card p-5 card-hover border-l-4 border-l-crisis-orange">
        <div class="text-xs text-slate-500 uppercase tracking-wider">Brent Crude</div>
        <div class="text-3xl font-black text-white mt-2" id="brent-price">--</div>
        <div class="text-sm mt-1" id="brent-change">--</div>
        <div class="text-xs text-slate-500 mt-2">ICE Futures Europe</div>
      </div>
      <div class="glass-card p-5 card-hover border-l-4 border-l-crisis-amber">
        <div class="text-xs text-slate-500 uppercase tracking-wider">WTI Crude</div>
        <div class="text-3xl font-black text-white mt-2" id="wti-price">--</div>
        <div class="text-sm mt-1" id="wti-change">--</div>
        <div class="text-xs text-slate-500 mt-2">NYMEX</div>
      </div>
      <div class="glass-card p-5 card-hover border-l-4 border-l-crisis-blue">
        <div class="text-xs text-slate-500 uppercase tracking-wider">EU Gas (TTF)</div>
        <div class="text-3xl font-black text-white mt-2" id="ttf-price">--</div>
        <div class="text-sm mt-1" id="ttf-change">--</div>
        <div class="text-xs text-slate-500 mt-2">Dutch Title Transfer Facility</div>
      </div>
      <div class="glass-card p-5 card-hover border-l-4 border-l-crisis-red">
        <div class="text-xs text-slate-500 uppercase tracking-wider">US Gasoline</div>
        <div class="text-3xl font-black text-white mt-2" id="gas-price">--</div>
        <div class="text-sm mt-1" id="gas-change">--</div>
        <div class="text-xs text-slate-500 mt-2">National Average ($/gal)</div>
      </div>
    </div>

    <!-- Pre-Crisis Comparison with Visual Bars -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">Pre-Crisis vs Current Comparison</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-ops-700/50">
              <th class="text-left py-2 text-slate-400 font-medium">Commodity</th>
              <th class="text-right py-2 text-slate-400 font-medium">Pre-Crisis</th>
              <th class="text-right py-2 text-slate-400 font-medium">Current</th>
              <th class="text-right py-2 text-slate-400 font-medium">Change</th>
              <th class="text-left py-2 text-slate-400 font-medium" style="min-width:200px">Visual</th>
            </tr>
          </thead>
          <tbody id="comparison-table">
            <tr class="border-b border-ops-800/50">
              <td class="py-2 text-white">Brent Crude</td>
              <td class="text-right text-slate-400" id="pre-brent">--</td>
              <td class="text-right text-white font-bold" id="cur-brent">--</td>
              <td class="text-right" id="chg-brent">--</td>
              <td class="py-2"><div class="h-4 bg-ops-800 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r from-crisis-green/60 to-crisis-red rounded-full" id="bar-brent" style="width:0%"></div></div></td>
            </tr>
            <tr class="border-b border-ops-800/50">
              <td class="py-2 text-white">WTI Crude</td>
              <td class="text-right text-slate-400" id="pre-wti">--</td>
              <td class="text-right text-white font-bold" id="cur-wti">--</td>
              <td class="text-right" id="chg-wti">--</td>
              <td class="py-2"><div class="h-4 bg-ops-800 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r from-crisis-green/60 to-crisis-red rounded-full" id="bar-wti" style="width:0%"></div></div></td>
            </tr>
            <tr class="border-b border-ops-800/50">
              <td class="py-2 text-white">EU Gas (TTF)</td>
              <td class="text-right text-slate-400" id="pre-ttf">--</td>
              <td class="text-right text-white font-bold" id="cur-ttf">--</td>
              <td class="text-right" id="chg-ttf">--</td>
              <td class="py-2"><div class="h-4 bg-ops-800 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r from-crisis-green/60 to-crisis-red rounded-full" id="bar-ttf" style="width:0%"></div></div></td>
            </tr>
            <tr>
              <td class="py-2 text-white">US Gasoline</td>
              <td class="text-right text-slate-400" id="pre-gas">--</td>
              <td class="text-right text-white font-bold" id="cur-gas">--</td>
              <td class="text-right" id="chg-gas">--</td>
              <td class="py-2"><div class="h-4 bg-ops-800 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r from-crisis-green/60 to-crisis-red rounded-full" id="bar-gas" style="width:0%"></div></div></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Sparkline Section -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">Price Trend (7-Day)</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="sparklines">
        <div class="bg-ops-900/50 rounded-lg p-3 border border-ops-700/30">
          <div class="text-xs text-slate-500 mb-1">Brent Crude</div>
          <canvas id="spark-brent" width="200" height="60"></canvas>
        </div>
        <div class="bg-ops-900/50 rounded-lg p-3 border border-ops-700/30">
          <div class="text-xs text-slate-500 mb-1">WTI Crude</div>
          <canvas id="spark-wti" width="200" height="60"></canvas>
        </div>
        <div class="bg-ops-900/50 rounded-lg p-3 border border-ops-700/30">
          <div class="text-xs text-slate-500 mb-1">EU Gas (TTF)</div>
          <canvas id="spark-ttf" width="200" height="60"></canvas>
        </div>
        <div class="bg-ops-900/50 rounded-lg p-3 border border-ops-700/30">
          <div class="text-xs text-slate-500 mb-1">US Gasoline</div>
          <canvas id="spark-gas" width="200" height="60"></canvas>
        </div>
      </div>
    </div>

    <!-- TradingView Brent Chart -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">Brent Crude — Live Chart</h2>
      <div class="tradingview-widget-container" style="height: 500px;">
        <div id="tradingview_chart" style="height: 100%;"></div>
      </div>
    </div>

    <!-- Historical Price Table -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">Key Price Milestones</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-ops-700/50">
              <th class="text-left py-2 text-slate-400 font-medium">Date</th>
              <th class="text-left py-2 text-slate-400 font-medium">Event</th>
              <th class="text-right py-2 text-slate-400 font-medium">Brent</th>
              <th class="text-right py-2 text-slate-400 font-medium">WTI</th>
              <th class="text-right py-2 text-slate-400 font-medium">Change</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-ops-800/50">
              <td class="py-2 text-slate-400 font-mono text-xs">Feb 27, 2026</td>
              <td class="py-2 text-white">Pre-crisis baseline</td>
              <td class="text-right text-slate-400 font-mono">$74.50</td>
              <td class="text-right text-slate-400 font-mono">$72.30</td>
              <td class="text-right text-slate-400">—</td>
            </tr>
            <tr class="border-b border-ops-800/50">
              <td class="py-2 text-slate-400 font-mono text-xs">Mar 1, 2026</td>
              <td class="py-2 text-white">Crisis begins</td>
              <td class="text-right text-white font-mono">$89.20</td>
              <td class="text-right text-white font-mono">$86.50</td>
              <td class="text-right text-crisis-red">+19.7%</td>
            </tr>
            <tr class="border-b border-ops-800/50">
              <td class="py-2 text-slate-400 font-mono text-xs">Mar 10, 2026</td>
              <td class="py-2 text-white">P&I clubs withdraw</td>
              <td class="text-right text-white font-mono">$98.40</td>
              <td class="text-right text-white font-mono">$95.80</td>
              <td class="text-right text-crisis-red">+32.1%</td>
            </tr>
            <tr class="border-b border-ops-800/50">
              <td class="py-2 text-slate-400 font-mono text-xs">Mar 20, 2026</td>
              <td class="py-2 text-white">First vessel seizure</td>
              <td class="text-right text-white font-mono">$105.60</td>
              <td class="text-right text-white font-mono">$102.30</td>
              <td class="text-right text-crisis-red">+41.7%</td>
            </tr>
            <tr class="border-b border-ops-800/50">
              <td class="py-2 text-slate-400 font-mono text-xs">Apr 15, 2026</td>
              <td class="py-2 text-white">SPR drawdown announced</td>
              <td class="text-right text-white font-mono">$112.80</td>
              <td class="text-right text-white font-mono">$109.50</td>
              <td class="text-right text-crisis-red">+51.4%</td>
            </tr>
            <tr>
              <td class="py-2 text-crisis-orange font-mono text-xs font-bold">Current</td>
              <td class="py-2 text-crisis-orange font-bold">Ongoing crisis</td>
              <td class="text-right text-crisis-red font-mono font-bold" id="hist-brent">--</td>
              <td class="text-right text-crisis-red font-mono font-bold" id="hist-wti">--</td>
              <td class="text-right text-crisis-red font-bold" id="hist-pct">--</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tanker Rates -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">Tanker Freight Rates</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="tanker-rates">
        <div class="bg-ops-900/50 rounded-lg p-4 border border-ops-700/30">
          <div class="text-xs text-slate-500 uppercase">VLCC TD3C (Ras Tanura → East)</div>
          <div class="text-2xl font-black text-white mt-2" id="vlcc-rate">--</div>
          <div class="text-xs mt-1" id="vlcc-change">--</div>
        </div>
        <div class="bg-ops-900/50 rounded-lg p-4 border border-ops-700/30">
          <div class="text-xs text-slate-500 uppercase">Suezmax TD6 (Black Sea → Med)</div>
          <div class="text-2xl font-black text-white mt-2">85 WS</div>
          <div class="text-xs text-crisis-red mt-1">+95% vs pre-crisis (43 WS)</div>
        </div>
        <div class="bg-ops-900/50 rounded-lg p-4 border border-ops-700/30">
          <div class="text-xs text-slate-500 uppercase">Aframax TD7 (North Sea → UKC)</div>
          <div class="text-2xl font-black text-white mt-2">72 WS</div>
          <div class="text-xs text-crisis-orange mt-1">+80% vs pre-crisis (40 WS)</div>
        </div>
      </div>
    </div>

    <!-- Oil Explained -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">Why Hormuz Oil Matters</h2>
      <div class="prose prose-invert prose-sm max-w-none">
        <p class="text-slate-300 leading-relaxed">The Strait of Hormuz is the world's most critical oil chokepoint, with approximately 21% of global petroleum consumption — roughly 20-21 million barrels per day — transiting through this narrow waterway between Oman and Iran. At its narrowest point, the strait is just 21 nautical miles wide, with only two 2-mile-wide navigation channels for inbound and outbound traffic. This geographic bottleneck makes it both indispensable for global energy supply and uniquely vulnerable to disruption.</p>
        <p class="text-slate-300 leading-relaxed mt-3">Brent crude, priced from the North Sea, serves as the international benchmark for two-thirds of the world's oil. When Hormuz closes, Brent reacts first and most violently because it reflects the price of seaborne crude that would normally transit the strait. The price transmission chain works as follows: the physical disruption reduces available supply, creating an immediate premium on any crude that can still reach market; this premium is reflected in the Brent futures market within minutes; from there, the price signal propagates to refined products like gasoline and diesel within days, and to consumer prices within weeks. The current crisis has demonstrated this chain with remarkable clarity — Brent surged from $74.50 pre-crisis to over $100, and US gasoline followed from $3.20 to over $4.10 within weeks.</p>
        <p class="text-slate-300 leading-relaxed mt-3">The historical comparison is sobering. The 1973 OPEC embargo saw oil prices quadruple, but that was a deliberate production cut. The 1990 Kuwait invasion saw prices double, but the disruption was partial and short-lived. The current Hormuz closure is unprecedented because it blocks the physical transit route, not just production. Even if oil is pumped from Saudi wells, it cannot reach Asian or European markets without the 12-day, $650,000-per-vessel detour around the Cape of Good Hope. This is why tanker spot rates have doubled and why the economic impact exceeds anything seen in previous oil shocks.</p>
      </div>
    </div>
  </div>

  <script>
    // Static oil data (no external API)
    const OIL_DATA = {
      brent: 116.73, wti: 113.40, ttf: 52.80, gasoline: 4.44,
      brentChangePercent: 56.7, wtiChangePercent: 56.8, ttfChangePercent: 85.3, gasolineChangePercent: 38.7,
      preCrisis: { brent: 74.50, wti: 72.30, ttf: 28.50, gasoline: 3.20 },
      sparkline: { brent: [98, 102, 108, 112, 115, 116, 116.73], wti: [95, 99, 105, 109, 112, 113, 113.40], ttf: [38, 42, 45, 48, 50, 52, 52.80], gasoline: [3.8, 3.9, 4.1, 4.2, 4.3, 4.4, 4.44] }
    };
    const DASH_DATA = {
      tankerRates: { currentRate: 100, changePercent: 100, preCrisisRate: 50 }
    };

    function drawSparkline(canvasId, data, color) {
      const canvas = document.getElementById(canvasId);
      if (!canvas || !data || data.length < 2) return;
      const ctx = canvas.getContext('2d');
      const w = canvas.width, h = canvas.height;
      const min = Math.min(...data), max = Math.max(...data);
      const range = max - min || 1;
      ctx.clearRect(0, 0, w, h);
      ctx.beginPath();
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      data.forEach((v, i) => {
        const x = (i / (data.length - 1)) * w;
        const y = h - ((v - min) / range) * (h - 8) - 4;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.stroke();
      // Fill
      const lastX = w, lastY = h - ((data[data.length - 1] - min) / range) * (h - 8) - 4;
      ctx.lineTo(lastX, h);
      ctx.lineTo(0, h);
      ctx.closePath();
      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, color + '30');
      grad.addColorStop(1, 'transparent');
      ctx.fillStyle = grad;
      ctx.fill();
    }

    function loadOilData() {
      const oil = OIL_DATA;
      const dash = DASH_DATA;

        const fmt = (n, p='$') => n != null ? p + Number(n).toFixed(2) : '--';
        const pctChg = (cur, pre) => pre ? ((cur - pre) / pre * 100).toFixed(1) + '%' : '--';

        document.getElementById('brent-price').textContent = fmt(oil.brent);
        document.getElementById('wti-price').textContent = fmt(oil.wti);
        document.getElementById('ttf-price').textContent = fmt(oil.ttf, '€');
        document.getElementById('gas-price').textContent = fmt(oil.gasoline);

        // Change indicators
        const setChg = (id, val) => {
          const el = document.getElementById(id);
          if (val == null) { el.textContent = '--'; return; }
          const up = val >= 0;
          el.textContent = `${up ? '+' : ''}${val.toFixed(2)}%`;
          el.className = `text-sm mt-1 ${up ? 'text-crisis-red' : 'text-crisis-green'}`;
        };
        setChg('brent-change', oil.brentChangePercent);
        setChg('wti-change', oil.wtiChangePercent);
        setChg('ttf-change', oil.ttfChangePercent);
        setChg('gas-change', oil.gasolineChangePercent);

        // Pre-crisis comparison
        const pre = oil.preCrisis || { brent: 74.50, wti: 72.30, ttf: 28.50, gasoline: 3.20 };
        document.getElementById('pre-brent').textContent = fmt(pre.brent);
        document.getElementById('cur-brent').textContent = fmt(oil.brent);
        const chgB = document.getElementById('chg-brent');
        const bPct = pctChg(oil.brent, pre.brent);
        chgB.textContent = '+' + bPct;
        chgB.className = 'text-right text-crisis-red font-bold';
        document.getElementById('bar-brent').style.width = Math.min(parseFloat(bPct), 100) + '%';

        document.getElementById('pre-wti').textContent = fmt(pre.wti);
        document.getElementById('cur-wti').textContent = fmt(oil.wti);
        const chgW = document.getElementById('chg-wti');
        const wPct = pctChg(oil.wti, pre.wti);
        chgW.textContent = '+' + wPct;
        chgW.className = 'text-right text-crisis-red font-bold';
        document.getElementById('bar-wti').style.width = Math.min(parseFloat(wPct), 100) + '%';

        document.getElementById('pre-ttf').textContent = fmt(pre.ttf, '€');
        document.getElementById('cur-ttf').textContent = fmt(oil.ttf, '€');
        const chgT = document.getElementById('chg-ttf');
        const tPct = pctChg(oil.ttf, pre.ttf);
        chgT.textContent = '+' + tPct;
        chgT.className = 'text-right text-crisis-red font-bold';
        document.getElementById('bar-ttf').style.width = Math.min(parseFloat(tPct), 100) + '%';

        document.getElementById('pre-gas').textContent = fmt(pre.gasoline);
        document.getElementById('cur-gas').textContent = fmt(oil.gasoline);
        const chgG = document.getElementById('chg-gas');
        const gPct = pctChg(oil.gasoline, pre.gasoline);
        chgG.textContent = '+' + gPct;
        chgG.className = 'text-right text-crisis-red font-bold';
        document.getElementById('bar-gas').style.width = Math.min(parseFloat(gPct), 100) + '%';

        // Historical price table current row
        document.getElementById('hist-brent').textContent = fmt(oil.brent);
        document.getElementById('hist-wti').textContent = fmt(oil.wti);
        document.getElementById('hist-pct').textContent = '+' + pctChg(oil.brent, pre.brent);

        // Sparklines
        if (oil.sparkline && Array.isArray(oil.sparkline) && oil.sparkline.length > 0) {
          drawSparkline('spark-brent', oil.sparkline, '#f97316');
        } else if (oil.sparkline && typeof oil.sparkline === 'object') {
          drawSparkline('spark-brent', oil.sparkline.brent || [], '#f97316');
          drawSparkline('spark-wti', oil.sparkline.wti || [], '#f59e0b');
          drawSparkline('spark-ttf', oil.sparkline.ttf || [], '#3b82f6');
          drawSparkline('spark-gas', oil.sparkline.gasoline || [], '#ef4444');
        }

        // Tanker rates
        const tr = dash.tankerRates;
        document.getElementById('vlcc-rate').textContent = (tr?.currentRate || 100) + ' WS';
        const vChg = document.getElementById('vlcc-change');
        vChg.textContent = `+${tr?.changePercent || 100}% vs pre-crisis (${tr?.preCrisisRate || 50} WS)`;
        vChg.className = 'text-xs mt-1 text-crisis-red';

      }
    }
    loadOilData();
  </script>

  <!-- TradingView Widget -->
  <script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
  <script>
    function initTV() {
      if (typeof TradingView === 'undefined') { setTimeout(initTV, 1000); return; }
      new TradingView.widget({
        "autosize": true,
        "symbol": "TVC:UKOIL",
        "interval": "D",
        "timezone": "Etc/UTC",
        "theme": "dark",
        "style": "1",
        "locale": "en",
        "toolbar_bg": "#0a1628",
        "enable_publishing": false,
        "allow_symbol_change": true,
        "container_id": "tradingview_chart",
        "hide_top_toolbar": false,
        "hide_legend": false,
        "save_image": false,
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initTV);
    else initTV();
  </script>
</Layout>
