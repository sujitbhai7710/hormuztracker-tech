---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Alternative Routes — HormuzTracker.tech" description="Compare alternative shipping routes around the Strait of Hormuz closure, including Cape of Good Hope detour and pipeline bypass options with interactive cost calculator." path="/routes">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6" id="routes-page">
    <div>
      <h1 class="text-2xl font-bold text-white">Alternative Routes & Pipelines</h1>
      <p class="text-sm text-slate-400 mt-1">Bypass options for shipping affected by the Hormuz closure</p>
    </div>

    <!-- Route Calculator -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">Interactive Route Cost Calculator</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="text-xs text-slate-400 uppercase tracking-wider">Select Route</label>
          <select id="route-select" class="mt-1 w-full bg-ops-800 border border-ops-600 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-crisis-blue">
          </select>
          <div class="mt-3">
            <label class="text-xs text-slate-400 uppercase tracking-wider">Number of Vessels</label>
            <input id="vessel-count" type="number" value="1" min="1" max="50" class="mt-1 w-full bg-ops-800 border border-ops-600 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-crisis-blue" />
          </div>
          <button id="calc-route-btn" class="mt-3 w-full px-4 py-2 rounded-lg bg-crisis-red/20 text-crisis-red border border-crisis-red/30 font-semibold hover:bg-crisis-red/30 transition-colors text-sm">Calculate Extra Cost</button>
          <div id="route-result" class="mt-4 space-y-3"></div>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-300 mb-3">Route Comparison Summary</h3>
          <div id="route-summary" class="space-y-2"></div>
        </div>
      </div>
    </div>

    <!-- Route Comparison Table -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">Route Comparison</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm" id="route-table">
          <thead>
            <tr class="border-b border-ops-700/50">
              <th class="text-left py-2 text-slate-400 font-medium">Route</th>
              <th class="text-right py-2 text-slate-400 font-medium">Normal Days</th>
              <th class="text-right py-2 text-slate-400 font-medium">Cape Days</th>
              <th class="text-right py-2 text-slate-400 font-medium">Extra Days</th>
              <th class="text-right py-2 text-slate-400 font-medium">Extra Cost</th>
              <th class="text-right py-2 text-slate-400 font-medium">Status</th>
            </tr>
          </thead>
          <tbody id="route-tbody"></tbody>
        </table>
      </div>
    </div>

    <!-- Pipeline Cards with Progress Bars -->
    <div>
      <h2 class="text-lg font-bold text-white mb-4">Pipeline Bypass Capacity</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="glass-card p-5 card-hover">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-base font-bold text-white">Saudi Petroline</h3>
            <span class="px-2 py-0.5 rounded text-xs bg-crisis-amber/20 text-crisis-amber border border-crisis-amber/30">5M bbl/day</span>
          </div>
          <p class="text-xs text-slate-400 mb-3">Eastern Province → Yanbu (Red Sea). At 1,200 km, it's the largest pipeline bypass but covers only 25% of normal Hormuz flow.</p>
          <div class="bg-ops-900/50 rounded-lg p-3">
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-500">Capacity vs Normal Flow</span>
              <span class="text-white font-bold">25%</span>
            </div>
            <div class="h-4 bg-ops-800 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-crisis-green to-crisis-amber rounded-full" style="width: 25%"></div>
            </div>
            <div class="flex justify-between text-[10px] text-slate-600 mt-1">
              <span>0</span>
              <span>5M / 20M bbl/day</span>
            </div>
          </div>
        </div>
        <div class="glass-card p-5 card-hover">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-base font-bold text-white">UAE ADCOP</h3>
            <span class="px-2 py-0.5 rounded text-xs bg-crisis-amber/20 text-crisis-amber border border-crisis-amber/30">1.5M bbl/day</span>
          </div>
          <p class="text-xs text-slate-400 mb-3">Habshan → Fujairah (Gulf of Oman). Bypasses the strait entirely. Covers 7.5% of normal flow.</p>
          <div class="bg-ops-900/50 rounded-lg p-3">
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-500">Capacity vs Normal Flow</span>
              <span class="text-white font-bold">7.5%</span>
            </div>
            <div class="h-4 bg-ops-800 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-crisis-green to-crisis-amber rounded-full" style="width: 7.5%"></div>
            </div>
            <div class="flex justify-between text-[10px] text-slate-600 mt-1">
              <span>0</span>
              <span>1.5M / 20M bbl/day</span>
            </div>
          </div>
        </div>
        <div class="glass-card p-5 card-hover">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-base font-bold text-white">Iraq-Turkey</h3>
            <span class="px-2 py-0.5 rounded text-xs bg-crisis-orange/20 text-crisis-orange border border-crisis-orange/30">0.5M bbl/day</span>
          </div>
          <p class="text-xs text-slate-400 mb-3">Kirkuk → Ceyhan (Mediterranean). Political disputes limit throughput. Just 2.5% of normal flow.</p>
          <div class="bg-ops-900/50 rounded-lg p-3">
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-500">Capacity vs Normal Flow</span>
              <span class="text-white font-bold">2.5%</span>
            </div>
            <div class="h-4 bg-ops-800 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-crisis-amber to-crisis-orange rounded-full" style="width: 2.5%"></div>
            </div>
            <div class="flex justify-between text-[10px] text-slate-600 mt-1">
              <span>0</span>
              <span>0.5M / 20M bbl/day</span>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-3 text-center">
        <span class="text-xs text-crisis-red font-bold">Total pipeline capacity: 7M bbl/day (35% of normal) — 13M bbl/day gap remains</span>
      </div>
    </div>

    <!-- Editorial -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">The Pipeline Gap Problem</h2>
      <div class="prose prose-invert prose-sm max-w-none">
        <p class="text-slate-300 leading-relaxed">The combined capacity of all three bypass pipelines totals just 7 million barrels per day — roughly 35% of the 20 million barrels per day that normally flow through the Strait of Hormuz. This 13 million barrel per day gap is the central problem of the current crisis. No combination of existing pipelines can replace the sheer volume of seaborne crude that transits the strait, and building new pipeline capacity takes years, not weeks.</p>
        <p class="text-slate-300 leading-relaxed mt-3">The Cape of Good Hope route adds 12-14 days to a typical voyage and approximately $500,000-$700,000 in additional costs per vessel. For the global economy, this translates to a daily surcharge measured in billions of dollars. The rerouting has also created a vessel shortage crisis, as ships tied up on longer routes cannot make their scheduled returns, leaving ports from Singapore to Rotterdam with empty container yards and delayed cargoes. The situation underscores a fundamental vulnerability in global energy infrastructure: the world's most critical oil chokepoint has no adequate backup plan.</p>
      </div>
    </div>
  </div>

  <script>
    const API = 'https://hormuz-api.tradesapi.workers.dev';
    const FALLBACK_ROUTES = [
      { name: 'Gulf → East Asia (China/Japan/Korea)', normalDays: 18, capeDays: 32, extraDays: 14, normalNm: 6400, capeNm: 11500, extraDistance: 5100, extraCostPerVessel: 650000, status: 'RESTRICTED' },
      { name: 'Gulf → Europe (Rotterdam)', normalDays: 15, capeDays: 27, extraDays: 12, normalNm: 5500, capeNm: 10200, extraDistance: 4700, extraCostPerVessel: 550000, status: 'RESTRICTED' },
      { name: 'Gulf → India', normalDays: 5, capeDays: 17, extraDays: 12, normalNm: 1500, capeNm: 5800, extraDistance: 4300, extraCostPerVessel: 500000, status: 'RESTRICTED' },
      { name: 'Gulf → Singapore', normalDays: 8, capeDays: 21, extraDays: 13, normalNm: 2900, capeNm: 7500, extraDistance: 4600, extraCostPerVessel: 580000, status: 'RESTRICTED' },
      { name: 'Gulf → US Gulf (via Cape)', normalDays: 22, capeDays: 35, extraDays: 13, normalNm: 8000, capeNm: 12500, extraDistance: 4500, extraCostPerVessel: 700000, status: 'RESTRICTED' },
      { name: 'Saudi Petroline → Red Sea', normalDays: 0, capeDays: 0, extraDays: 0, normalNm: 0, capeNm: 0, extraDistance: 0, extraCostPerVessel: 0, status: 'PIPELINE' },
      { name: 'UAE ADCOP → Fujairah', normalDays: 0, capeDays: 0, extraDays: 0, normalNm: 0, capeNm: 0, extraDistance: 0, extraCostPerVessel: 0, status: 'PIPELINE' },
    ];
    let routes = [];

    function getStatusClass(status) {
      if (status === 'CLOSED') return 'text-crisis-red bg-crisis-red/10';
      if (status === 'RESTRICTED') return 'text-crisis-orange bg-crisis-orange/10';
      if (status === 'PIPELINE') return 'text-crisis-green bg-crisis-green/10';
      return 'text-crisis-amber bg-crisis-amber/10';
    }

    async function loadRoutes() {
      try {
        const res = await fetch(`${API}/api/routes`);
        routes = await res.json();
        if (!Array.isArray(routes) || routes.length === 0) routes = FALLBACK_ROUTES;
      } catch (e) {
        console.error('Routes API failed, using fallback:', e);
        routes = FALLBACK_ROUTES;
      }

      const sel = document.getElementById('route-select');
      const tbody = document.getElementById('route-tbody');

      // Only add sea routes to the calculator dropdown
      const seaRoutes = routes.filter(r => r.status !== 'PIPELINE' && r.extraDays > 0);
      seaRoutes.forEach((r, i) => {
        const opt = document.createElement('option');
        opt.value = i; opt.textContent = r.name;
        sel.appendChild(opt);
      });

      // Add all routes to the table
      routes.forEach(r => {
        const statusClass = getStatusClass(r.status);
        const extraDaysStr = r.extraDays > 0 ? `+${r.extraDays}d` : '—';
        const extraCostStr = r.extraCostPerVessel > 0 ? `+$${(r.extraCostPerVessel/1000).toFixed(0)}K` : '—';
        tbody.innerHTML += `<tr class="border-b border-ops-800/50">
          <td class="py-2 text-white font-medium">${r.name}</td>
          <td class="text-right text-slate-400">${r.normalDays > 0 ? r.normalDays + 'd' : '—'}</td>
          <td class="text-right text-slate-400">${r.capeDays > 0 ? r.capeDays + 'd' : '—'}</td>
          <td class="text-right ${r.extraDays > 0 ? 'text-crisis-orange font-bold' : 'text-slate-500'}">${extraDaysStr}</td>
          <td class="text-right ${r.extraCostPerVessel > 0 ? 'text-crisis-red font-bold' : 'text-slate-500'}">${extraCostStr}</td>
          <td class="text-right"><span class="px-2 py-0.5 rounded text-xs ${statusClass}">${r.status}</span></td>
        </tr>`;
      });

      // Route summary - only sea routes
      document.getElementById('route-summary').innerHTML = seaRoutes.slice(0, 5).map(r => `
        <div class="bg-ops-900/50 rounded-lg p-3 border border-ops-700/30 flex justify-between items-center">
          <div>
            <div class="text-sm font-medium text-white">${r.name}</div>
            <div class="text-xs text-slate-500">+${r.extraDays} days · +${(r.extraDistance || 0).toLocaleString()} nm</div>
          </div>
          <div class="text-right">
            <div class="text-sm font-bold text-crisis-red">+$${(r.extraCostPerVessel/1000).toFixed(0)}K</div>
            <div class="text-[10px] text-slate-500">per vessel</div>
          </div>
        </div>
      `).join('');

      // Calculator
      function calculateRoute() {
        const idx = parseInt(sel.value);
        const r = seaRoutes[idx];
        if (!r) return;
        const vessels = parseInt(document.getElementById('vessel-count').value) || 1;
        const totalExtra = r.extraCostPerVessel * vessels;
        document.getElementById('route-result').innerHTML = `
          <div class="bg-ops-900/50 rounded-lg p-4 border border-ops-700/30 space-y-3">
            <div class="flex justify-between"><span class="text-xs text-slate-500">Normal Route</span><span class="text-sm text-white font-bold">${r.normalDays} days / ${r.normalNm?.toLocaleString() || '—'} nm</span></div>
            <div class="flex justify-between"><span class="text-xs text-slate-500">Via Cape of Good Hope</span><span class="text-sm text-white font-bold">${r.capeDays} days / ${r.capeNm?.toLocaleString() || '—'} nm</span></div>
            <hr class="border-ops-700/50">
            <div class="flex justify-between"><span class="text-xs text-slate-500">Extra Days</span><span class="text-sm text-crisis-orange font-bold">+${r.extraDays} days</span></div>
            <div class="flex justify-between"><span class="text-xs text-slate-500">Extra Distance</span><span class="text-sm text-crisis-orange font-bold">+${r.extraDistance?.toLocaleString() || '—'} nm</span></div>
            <div class="flex justify-between"><span class="text-xs text-slate-500">Extra Cost per Vessel</span><span class="text-sm text-crisis-red font-bold">+$${(r.extraCostPerVessel/1000).toFixed(0)}K</span></div>
            ${vessels > 1 ? `<hr class="border-ops-700/50"><div class="flex justify-between"><span class="text-xs text-slate-500">Total Extra Cost (${vessels} vessels)</span><span class="text-lg text-crisis-red font-black">+$${(totalExtra/1000000).toFixed(2)}M</span></div>` : ''}
            <div class="text-[10px] text-slate-600 mt-2">*Estimates based on current market rates. Actual costs vary by vessel size, fuel price, and port charges.</div>
          </div>`;
      }

      sel.addEventListener('change', calculateRoute);
      document.getElementById('vessel-count').addEventListener('input', calculateRoute);
      document.getElementById('calc-route-btn').addEventListener('click', calculateRoute);
      if (seaRoutes.length > 0) calculateRoute();
    }
    loadRoutes();
  </script>
</Layout>
