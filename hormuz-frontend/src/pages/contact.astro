---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us — HormuzTracker.tech" description="Contact HormuzTracker.tech — get in touch about press inquiries, data corrections, partnerships, or general questions about our Strait of Hormuz crisis monitoring platform." path="/contact">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-6 space-y-6">
    <div>
      <h1 class="text-2xl font-bold text-white">Contact Us</h1>
      <p class="text-sm text-slate-400 mt-1">Get in touch with the HormuzTracker.tech team</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- General Inquiries -->
      <div class="glass-card p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-crisis-red/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-crisis-red" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h2 class="text-base font-bold text-white">General Inquiries</h2>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">For questions about our platform, data sources, methodology, or general feedback about HormuzTracker.tech.</p>
        <a href="mailto:contact@hormuztracker.tech" class="inline-flex items-center gap-2 mt-3 text-sm text-crisis-orange hover:text-crisis-orange/80 transition-colors">
          <span>contact@hormuztracker.tech</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>

      <!-- Press & Media -->
      <div class="glass-card p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-crisis-orange/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-crisis-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
          </div>
          <h2 class="text-base font-bold text-white">Press & Media</h2>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">Journalists and media organizations seeking data, expert commentary, or interview requests regarding the Strait of Hormuz crisis.</p>
        <a href="mailto:press@hormuztracker.tech" class="inline-flex items-center gap-2 mt-3 text-sm text-crisis-orange hover:text-crisis-orange/80 transition-colors">
          <span>press@hormuztracker.tech</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>

      <!-- Data Corrections -->
      <div class="glass-card p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-emerald-500/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h2 class="text-base font-bold text-white">Data Corrections</h2>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">If you notice inaccurate data on our platform, please let us know. We take data accuracy seriously and will investigate and correct verified errors promptly.</p>
        <a href="mailto:data@hormuztracker.tech" class="inline-flex items-center gap-2 mt-3 text-sm text-crisis-orange hover:text-crisis-orange/80 transition-colors">
          <span>data@hormuztracker.tech</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>

      <!-- Privacy & Legal -->
      <div class="glass-card p-5">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-slate-500/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
          </div>
          <h2 class="text-base font-bold text-white">Privacy & Legal</h2>
        </div>
        <p class="text-sm text-slate-300 leading-relaxed">For privacy inquiries, data access requests, legal matters, or to exercise your rights under applicable data protection regulations.</p>
        <a href="mailto:privacy@hormuztracker.tech" class="inline-flex items-center gap-2 mt-3 text-sm text-crisis-orange hover:text-crisis-orange/80 transition-colors">
          <span>privacy@hormuztracker.tech</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>

    <!-- Social & Community -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-4">Follow Us</h2>
      <p class="text-sm text-slate-300 leading-relaxed mb-4">Stay updated on Strait of Hormuz developments and platform updates through our social media channels.</p>
      <div class="flex flex-wrap gap-3">
        <a href="https://twitter.com/hormuztracker" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-ops-800/50 hover:bg-ops-800 text-slate-300 hover:text-white transition-all text-sm">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span>X (Twitter)</span>
        </a>
        <a href="https://github.com/hormuztracker" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-ops-800/50 hover:bg-ops-800 text-slate-300 hover:text-white transition-all text-sm">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          <span>GitHub</span>
        </a>
        <a href="https://linkedin.com/company/hormuztracker" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-ops-800/50 hover:bg-ops-800 text-slate-300 hover:text-white transition-all text-sm">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          <span>LinkedIn</span>
        </a>
      </div>
    </div>

    <!-- Partnerships -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-3">Partnerships</h2>
      <p class="text-sm text-slate-300 leading-relaxed">We welcome partnerships with news organizations, research institutions, and maritime industry stakeholders. For partnership inquiries or custom data feeds, please reach out to us at <a href="mailto:partnerships@hormuztracker.tech" class="text-crisis-orange hover:underline">partnerships@hormuztracker.tech</a>.</p>
      <div class="mt-3 p-3 rounded-lg bg-ops-800/30 border border-ops-700/50">
        <p class="text-xs text-slate-500">For technical issues with our website functionality, please include your browser version, operating system, and a detailed description of the issue when contacting us.</p>
      </div>
    </div>

    <!-- Response Expectations -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-3">Response Times</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-ops-700/50">
              <th class="text-left py-2 text-slate-400 font-medium">Inquiry Type</th>
              <th class="text-left py-2 text-slate-400 font-medium">Expected Response</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-ops-800/50"><td class="py-2 text-white">Data Corrections</td><td class="text-slate-400">Within 24 hours</td></tr>
            <tr class="border-b border-ops-800/50"><td class="py-2 text-white">Press Inquiries</td><td class="text-slate-400">Within 12 hours</td></tr>
            <tr class="border-b border-ops-800/50"><td class="py-2 text-white">Privacy Requests</td><td class="text-slate-400">Within 30 days (as required by law)</td></tr>
            <tr class="border-b border-ops-800/50"><td class="py-2 text-white">General Inquiries</td><td class="text-slate-400">Within 48 hours</td></tr>
            <tr><td class="py-2 text-white">Partnership Requests</td><td class="text-slate-400">Within 5 business days</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Legal Links -->
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-white mb-3">Legal Information</h2>
      <p class="text-sm text-slate-300 leading-relaxed">Before contacting us, you may find the information you need in our legal documents:</p>
      <div class="flex flex-wrap gap-3 mt-3">
        <a href="/privacy" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-ops-800/50 hover:bg-ops-800 text-slate-300 hover:text-white transition-all text-sm">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          Privacy Policy
        </a>
        <a href="/terms" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-ops-800/50 hover:bg-ops-800 text-slate-300 hover:text-white transition-all text-sm">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Terms of Service
        </a>
        <a href="/methodology" class="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-ops-800/50 hover:bg-ops-800 text-slate-300 hover:text-white transition-all text-sm">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
          Methodology
        </a>
      </div>
    </div>
  </div>
</Layout>
