---
// Embeddable Ship Count Widget — no Layout, minimal inline CSS
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hormuz Ship Count</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #050a14; color: #e2e8f0; display: flex; align-items: center; justify-content: center; min-height: 200px; }
    .widget { width: 300px; padding: 16px; background: linear-gradient(135deg, rgba(15,32,53,0.9), rgba(10,22,40,0.95)); border: 1px solid rgba(58,84,120,0.25); border-radius: 12px; }
    .title { font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: #8aa4c0; margin-bottom: 8px; }
    .count { font-size: 36px; font-weight: 900; color: #fff; font-family: 'JetBrains Mono', monospace; line-height: 1; }
    .vs { font-size: 12px; color: #5a7a9e; margin-top: 4px; }
    .vs span { color: #f97316; font-weight: 700; }
    .bar-wrap { margin-top: 12px; }
    .bar-label { display: flex; justify-content: space-between; font-size: 10px; color: #5a7a9e; margin-bottom: 4px; }
    .bar { height: 8px; background: #0f2035; border-radius: 4px; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 4px; transition: width 0.8s ease; }
    .bar-current { background: linear-gradient(90deg, #f97316, #ef4444); }
    .bar-normal { background: #3a5478; }
    .update { font-size: 9px; color: #3a5478; margin-top: 8px; text-align: right; }
  </style>
</head>
<body>
  <div class="widget">
    <div class="title">Ships in Strait of Hormuz</div>
    <div class="count" id="ship-count">—</div>
    <div class="vs">vs <span id="normal-count">—</span> normal daily average</div>
    <div class="bar-wrap">
      <div class="bar-label">
        <span>Current</span>
        <span>Normal</span>
      </div>
      <div style="position:relative;">
        <div class="bar"><div class="bar-fill bar-normal" id="bar-normal" style="width: 100%"></div></div>
        <div class="bar" style="position:absolute;top:0;left:0;"><div class="bar-fill bar-current" id="bar-current" style="width: 3%"></div></div>
      </div>
    </div>
    <div class="update" id="last-update">Loading...</div>
  </div>
  <script>
    const API = 'https://hormuz-api.tradesapi.workers.dev';
    async function load() {
      try {
        const [ais, dash] = await Promise.all([
          fetch(`${API}/api/ais`).then(r => r.json()),
          fetch(`${API}/api/dashboard`).then(r => r.json()),
        ]);
        const current = dash.shipCount?.last24h || ais?.shipsDetected || 0;
        const normal = dash.shipCount?.normalDaily || 60;
        document.getElementById('ship-count').textContent = current;
        document.getElementById('normal-count').textContent = normal;
        const pct = Math.min((current / normal) * 100, 100);
        document.getElementById('bar-current').style.width = pct + '%';
        document.getElementById('last-update').textContent = 'Updated ' + new Date().toLocaleTimeString();
      } catch (e) {
        document.getElementById('ship-count').textContent = '—';
        document.getElementById('last-update').textContent = 'Error loading data';
      }
    }
    load();
    setInterval(load, 300000);
  </script>
</body>
</html>
