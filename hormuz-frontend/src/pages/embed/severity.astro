---
// Embeddable Severity Widget — no Layout, minimal inline CSS
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hormuz Crisis Severity</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #050a14; color: #e2e8f0; display: flex; align-items: center; justify-content: center; min-height: 80px; }
    .widget { display: flex; align-items: center; gap: 12px; padding: 10px 16px; background: linear-gradient(135deg, rgba(15,32,53,0.9), rgba(10,22,40,0.95)); border: 1px solid rgba(58,84,120,0.25); border-radius: 10px; min-width: 220px; }
    .severity { font-size: 28px; font-weight: 900; font-family: 'JetBrains Mono', monospace; }
    .sev-critical { color: #ef4444; }
    .sev-high { color: #f97316; }
    .sev-moderate { color: #f59e0b; }
    .sev-low { color: #22c55e; }
    .info { display: flex; flex-direction: column; gap: 2px; }
    .status { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 2px 6px; border-radius: 4px; display: inline-block; }
    .status-restricted { color: #f97316; background: rgba(249,115,22,0.15); }
    .status-closed { color: #ef4444; background: rgba(239,68,68,0.15); }
    .status-open { color: #22c55e; background: rgba(34,197,94,0.15); }
    .day { font-size: 11px; color: #8aa4c0; }
    .pulse { width: 8px; height: 8px; border-radius: 50%; animation: pulse 2s ease-in-out infinite; flex-shrink: 0; }
    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  </style>
</head>
<body>
  <div class="widget" id="widget">
    <div class="pulse" id="pulse" style="background: #ef4444;"></div>
    <div>
      <div class="severity" id="severity-score">—</div>
    </div>
    <div class="info">
      <span class="status" id="strait-status">LOADING</span>
      <span class="day" id="day-count">Day —</span>
    </div>
  </div>
  <script>
    const API = 'https://hormuz-api.tradesapi.workers.dev';
    async function load() {
      try {
        const d = await fetch(`${API}/api/dashboard`).then(r => r.json());
        const score = d.severityScore || 10;
        const el = document.getElementById('severity-score');
        el.textContent = score + '/10';
        el.className = 'severity ' + (score >= 8 ? 'sev-critical' : score >= 6 ? 'sev-high' : score >= 4 ? 'sev-moderate' : 'sev-low');
        const status = (d.straitStatus?.status || 'RESTRICTED').toUpperCase();
        const statusEl = document.getElementById('strait-status');
        statusEl.textContent = status;
        statusEl.className = 'status ' + (status.includes('CLOSED') ? 'status-closed' : status.includes('OPEN') ? 'status-open' : 'status-restricted');
        const crisisStart = new Date('2026-02-28T00:00:00Z');
        const dayNum = Math.floor((Date.now() - crisisStart.getTime()) / 86400000);
        document.getElementById('day-count').textContent = 'Day ' + dayNum;
        document.getElementById('pulse').style.background = score >= 8 ? '#ef4444' : score >= 6 ? '#f97316' : '#f59e0b';
      } catch (e) {
        document.getElementById('severity-score').textContent = '—';
        document.getElementById('strait-status').textContent = 'ERROR';
      }
    }
    load();
    setInterval(load, 300000);
  </script>
</body>
</html>
